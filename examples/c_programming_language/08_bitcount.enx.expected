#include <stdio.h>

int bitcount(unsigned x) {
    int b;
    for (b = 0; x != 0; x >>= 1) {
        if (x & 1) {
            b++;
        }
    }
    return b;
}
int main(void) {
    unsigned value = 0xF0;
    int bits = bitcount(value);
    printf("%u has %d bits\n", value, bits);
    return 0;
}
