#include <stdio.h>

void reverse(char s[]) {
    int i = 0;
    int j = 0;
    char temp;

    while (s[j] != '\0') {
        j++;
    }
    j--;

    while (i < j) {
        temp = s[i];
        s[i] = s[j];
        s[j] = temp;
        i++;
        j--;
    }
}
int main(void) {
    char text[] = "hello";
    char *word = text;
    reverse(word);
    printf("%s\n", text);
    return 0;
}
