#include <stdio.h>

void swap(int v[], int i, int j) {
    int temp = v[i];
    v[i] = v[j];
    v[j] = temp;
}

void qsort(int v[], int left, int right) {
    int i;
    int last;

    if (left >= right) {
        return;
    }
    swap(v, left, (left + right) / 2);
    last = left;
    for (i = left + 1; i <= right; i++) {
        if (v[i] < v[left]) {
            swap(v, ++last, i);
        }
    }
    swap(v, left, last);
    qsort(v, left, last - 1);
    qsort(v, last + 1, right);
}
int main(void) {
    int values[] = { 3, 1, 4, 1, 5, 9, 2, 6 };
    int *numbers = values;
    int i;

    qsort(numbers, 0, 7);
    for (i = 0; i < 8; i++) {
        printf("%d\n", values[i]);
    }
    return 0;
}
