#include <stdio.h>
int main(void) {
    const char *text = "hello";
    int counts[26] = { 0 };
    int i;

    for (i = 0; text[i] != '\0'; i++) {
        counts[text[i] - 'a']++;
    }

    for (i = 0; i < 26; i++) {
        if (counts[i] > 0) {
            printf("%c: %d\n", 'a' + i, counts[i]);
        }
    }
    return 0;
}
