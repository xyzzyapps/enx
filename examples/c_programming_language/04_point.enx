A point has an x and a y coordinate.

#include <stdio.h>

struct point {
    int x;
    int y;
};

A function moves a point by a delta.

struct point move(struct point p, int dx, int dy) {
    p.x = p.x + dx;
    p.y = p.y + dy;
    return p;
}

Then main creates a point, moves it and prints the result. int main(void) {
    struct point p = { 2, 3 };
    struct point q = move(p, 4, -1);
    printf("point: %d,%d\n", q.x, q.y);
    return 0;
}
