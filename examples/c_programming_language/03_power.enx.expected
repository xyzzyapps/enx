#include <stdio.h>

int power(int base, int exponent) {
    int result = 1;
    int i;
    for (i = 0; i < exponent; i++) {
        result = result * base;
    }
    return result;
}
int main(void) {
    int i;
    for (i = 0; i <= 5; i++) {
        printf("2^%d = %d\n", i, power(2, i));
    }
    return 0;
}
