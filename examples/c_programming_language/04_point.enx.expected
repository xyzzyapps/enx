#include <stdio.h>

struct point {
    int x;
    int y;
};
struct point move(struct point p, int dx, int dy) {
    p.x = p.x + dx;
    p.y = p.y + dy;
    return p;
}
int main(void) {
    struct point p = { 2, 3 };
    struct point q = move(p, 4, -1);
    printf("point: %d,%d\n", q.x, q.y);
    return 0;
}
