class Document
  attr_reader :title, :body

  def initialize(title, body)
    @title = title
    @body = body
  end

  def word_count
    body.split.size
  end

  def to_s
    "#{title}: #{word_count} words"
  end
end
doc = Document.new("A short note", "write code the way you explain it")
words = doc.word_count
puts doc
puts words
