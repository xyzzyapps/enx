A tiny shop that prices an order of a few things.

We need the standard input and output header first.

#include <stdio.h>

Money is kept as whole cents, so here is a helper that adds two amounts.

typedef struct { long cents; } money_t;

static money_t money_add(money_t a, money_t b) {
    money_t r;
    r.cents = a.cents + b.cents;
    return r;
}

A product is a name and a price in cents.

typedef struct {
    const char *name;
    money_t price;
} product_t;

An order holds a few products in a fixed size array, and it can add them up.

#define MAX_LINES 8

typedef struct {
    product_t items[MAX_LINES];
    int count;
} order_t;

static void order_add(order_t *o, product_t p) {
    if (o->count < MAX_LINES) {
        o->items[o->count] = p;
        o->count++;
    }
}

static money_t order_total(const order_t *o) {
    money_t total = { 0 };
    for (int i = 0; i < o->count; i++) {
        total = money_add(total, o->items[i].price);
    }
    return total;
}

A helper that formats an amount of cents as a dollar string.

static void money_str(char *buf, size_t n, money_t m) {
    snprintf(buf, n, "$%ld.%02ld", m.cents / 100, m.cents % 100);
}

Now the entry point builds a small order and prints the total.

int main(void) {
    order_t order;
    order.count = 0;

    product_t coffee = { "Coffee Beans", { 1299 } };
    product_t mug = { "Ceramic Mug", { 850 } };

    order_add(&order, coffee);
    order_add(&order, mug);
    order_add(&order, coffee);

    money_t total = order_total(&order);

    char buf[32];
    money_str(buf, sizeof buf, total);

    printf("items: %d\n", order.count);
    printf("total: %s\n", buf);

    return 0;
}
